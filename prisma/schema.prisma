generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
} 

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [uuid_ossp(map: "uuid-ossp")]
}

model User {
  id        String  @id @default(uuid()) @db.Uuid
  username  String  @unique
  password  String
  is_admin  Boolean @default(false)
  f_name    String
  m_name    String
  l_name    String
}

model Project {
  id                String        @id @default(uuid()) @db.Uuid
  title             String        @unique
  description       String
  department        DEPT          @default(PEMB)
  location          String
  type              ProjectType
  otherType         String?
  technologyused    String
  designingSoftware String?
  status            ProjectStatus
  images            Json          @default("[]")  @db.JsonB

  @@map("project")
}

model PortfolioWork {
  id          String  @id @default(uuid()) @db.Uuid
  title       String  @unique
  description String
  file        Json    @default("[]")
  status      Boolean @default(false)

  @@map("portfoliowork")
}

model JobRole {
  id             String         @id @default(uuid()) @db.Uuid
  Role           String
  location       String
  type           String
  qualification  String
  jd             Json           @default("[]")
  status         Boolean        @default(false)
  applications   Applications[] @relation("applicants")

  @@map("jobrole")
}

model Applications {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  email     String    @unique
  phone     String
  resume    Json     @default("[]")
  createdAt DateTime @default(now())
  status    Boolean  @default(false)
  rejected  Boolean  @default(false)
  jbroleId  String   @db.Uuid
  jobrole   JobRole  @relation("applicants", fields: [jbroleId], references: [id], onDelete: Cascade)
}

model Post{
  id                  String          @id @default(uuid()) @db.Uuid
  title               String          @unique
  content             String        
  files               Json            @default("[]")
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  likes               Int             @default(0)

  comments            Comment[]       @relation("comments")
  

  @@map("post")
}

model Comment{
  id                    String         @id @default(uuid()) @db.Uuid
  content               String         
  postId                String         @db.Uuid
  likes                 Int            @default(0)
  parentId              String?        @db.Uuid
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  post                  Post           @relation("comments",fields:[postId],references:[id])
  parentComment         Comment?        @relation("responseComment",fields:[parentId],references:[id])
  childComments         Comment[]      @relation("responseComment")

  @@map("comment")
}


model CustomerData{
  id                   String       @id @default(uuid()) @db.Uuid
  name                 String
  email                String
  phone                String
  message              String
  createdAt            DateTime    @default(now())

  @@map("customerdata")
}

enum ProjectType {
  INSTITUTE
  COMMERCIAL
  FACILITY_EXPRESSION
  INDUSTRIAL
  OTHER
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  COMPLETED
  ON_HOLD
  CANCELLED
}
enum DEPT{
  PEMB
  STRUCTURAL
}

model Leadership {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  designation String
  bio         String
  profilePic  Json     @default("[]")
  socialLinks Json     @default("[]")

  @@map("leadership")
}
model WhyUsPic {
  id          String      @id @default(uuid())
  image       Json          @default("[]")  @db.JsonB
  tag         String
  title       String
  description String   @db.Text
  order       Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}